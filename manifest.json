{
  "id": "github",
  "name": "GitHub",
  "version": "0.1.0",
  "minBaryntVersion": "1.0.0",
  "author": "Barynt",
  "authorUrl": "https://github.com/barynt-dev",
  "description": "Pull requests, branches, commits and checks on the issues they name. Rules move an issue along as its pull request does.",
  "license": "MIT",
  "kind": "sandbox",
  "levels": ["project"],
  "capabilities": [
    "issues:read",
    "issues:write",
    "comments:write",
    "webhooks:receive",
    "ui:issue-badge"
  ],
  "network": ["api.github.com"],
  "contributes": {
    "issueBadges": [
      {
        "id": "pull-request",
        "title": "Pull request"
      }
    ],
    "credentials": [
      {
        "key": "githubToken",
        "label": "GitHub token",
        "description": "A fine-grained token for the team's repositories: Contents read and write (for branches), Pull requests and Checks read. Only ever sent to api.github.com.",
        "level": "user",
        "host": "api.github.com",
        "format": "Bearer {value}"
      }
    ],
    "inboundHooks": [
      {
        "id": "github",
        "title": "GitHub repository",
        "provider": "github",
        "handle": "link",
        "rules": [
          {
            "id": "opened",
            "title": "When a pull request is opened",
            "on": "pull_request.opened"
          },
          {
            "id": "merged",
            "title": "When a pull request is merged",
            "on": "pull_request.merged"
          }
        ]
      }
    ]
  }
}
