{
  "id": "github",
  "name": "GitHub",
  "version": "0.1.0-beta.4",
  "minBaryntVersion": "1.1.0-beta.5",
  "author": "Barynt",
  "authorUrl": "https://github.com/barynt-dev",
  "description": {
    "short": "Pull requests, branches and checks on the issues they belong to: on the board, in the issue, and with rules that move the issue along.",
    "about": "about.md"
  },
  "locales": {
    "de": {
      "description": {
        "short": "Pull Requests, Branches und Checks direkt an ihren Issues: auf dem Board, im Issue und mit Regeln, die das Issue weitersetzen.",
        "about": "about.de.md"
      },
      "contributes": {
        "actions": {
          "create-branch": "Branch erstellen",
          "copy-branch-name": "Branch-Namen kopieren",
          "open-pull-request": "Pull Request öffnen"
        },
        "issuePanels": {
          "development": "Entwicklung"
        },
        "issueBadges": {
          "pull-request": "Pull Request"
        },
        "settings": {
          "repositories": {
            "label": "Repositories",
            "description": "Die Repositories, mit denen dieses Projekt arbeitet – aus den oben verbundenen GitHub-Konten. Branches entstehen im ersten."
          },
          "branchPattern": {
            "label": "Branch-Name",
            "description": "{type} ist feature, bugfix oder chore je nach Issue-Typ, {user} der GitHub-Login, {key} der Schlüssel des Issues, {title} sein Titel. Behalte {key}: Daran erkennt Barynt das Issue.",
            "suggestions": {
              "type-key-title": {
                "label": "Typ, Schlüssel und Titel (empfohlen)",
                "hint": "feature/web-42-session-cookie-behalten"
              },
              "key-title": {
                "label": "Schlüssel und Titel",
                "hint": "web-42-session-cookie-behalten – wie Jira und GitHub"
              },
              "user-key-title": {
                "label": "Login, Schlüssel und Titel",
                "hint": "ada/web-42-session-cookie-behalten – wie Linear"
              },
              "type-key": {
                "label": "Typ und Schlüssel",
                "hint": "feature/web-42 – kurz"
              },
              "key": {
                "label": "Nur Schlüssel",
                "hint": "web-42 – am kürzesten"
              }
            }
          },
          "branchAssign": "Issue der Person zuweisen, die seinen Branch erstellt",
          "branchStatus": {
            "label": "Status, wenn ein Branch erstellt wird",
            "description": "Leer lassen, um den Status zu behalten."
          }
        },
        "credentials": {
          "githubToken": {
            "label": "Dein GitHub-Token (optional)",
            "description": "Optional: Branches mit deinem GitHub-Login im Namen und wer reviewt hat. Ohne Token nutzt das Plugin die GitHub-Verbindung des Projekts. Fine-grained: Contents Lesen und Schreiben, Pull requests und Checks Lesen."
          }
        },
        "inboundHooks": {
          "github": {
            "title": "GitHub-Repository",
            "rules": {
              "opened": "Wenn ein Pull Request geöffnet wird",
              "merged": "Wenn ein Pull Request gemergt wird"
            }
          }
        }
      },
      "previews": {
        "preview-1.webp": "Pull Requests auf dem Board",
        "preview-2.webp": "Entwicklung-Panel im Issue",
        "preview-3.webp": "Webhook und Regeln"
      }
    }
  },
  "links": [
    {
      "kind": "docs",
      "url": "https://github.com/barynt-dev/barynt-plugin-github#readme"
    },
    {
      "kind": "changelog",
      "url": "https://github.com/barynt-dev/barynt-plugin-github/releases"
    },
    {
      "kind": "issues",
      "url": "https://github.com/barynt-dev/barynt-plugin-github/issues"
    },
    {
      "kind": "github",
      "url": "https://github.com/barynt-dev/barynt-plugin-github"
    }
  ],
  "logo": "logo.png",
  "license": "MIT",
  "kind": "sandbox",
  "levels": ["project"],
  "capabilities": [
    "issues:read",
    "issues:write",
    "comments:write",
    "webhooks:receive",
    "ui:issue-badge",
    "ui:issue-panel",
    "ui:action"
  ],
  "network": ["api.github.com"],
  "contributes": {
    "issueBadges": [
      {
        "id": "pull-request",
        "title": "Pull request"
      }
    ],
    "issuePanels": [
      {
        "id": "development",
        "title": "Development",
        "placement": "sidebar"
      }
    ],
    "actions": [
      {
        "id": "create-branch",
        "title": "Create branch",
        "icon": "lucide:git-branch",
        "where": ["issueMenu", "cardMenu", "commandPalette"]
      },
      {
        "id": "copy-branch-name",
        "title": "Copy branch name",
        "icon": "lucide:git-branch",
        "where": ["issueMenu", "cardMenu", "commandPalette"]
      },
      {
        "id": "open-pull-request",
        "title": "Open pull request",
        "icon": "lucide:git-pull-request",
        "where": ["issueMenu", "commandPalette"]
      }
    ],
    "connections": [
      {
        "id": "github",
        "title": "GitHub",
        "provider": "github"
      }
    ],
    "settings": [
      {
        "key": "repositories",
        "type": "repositories",
        "label": "Repositories",
        "description": "The repositories this project works with — from the GitHub accounts connected above. Branches are created in the first."
      },
      {
        "key": "branchPattern",
        "type": "text",
        "label": "Branch name",
        "description": "{type} is feature, bugfix or chore by the issue's type, {user} the GitHub login, {key} the issue's key, {title} its title. Keep {key}: it's how Barynt finds the issue.",
        "default": "{type}/{key}-{title}",
        "suggestions": [
          {
            "id": "type-key-title",
            "value": "{type}/{key}-{title}",
            "label": "Type, key and title (recommended)",
            "hint": "feature/web-42-keep-the-session-cookie"
          },
          {
            "id": "key-title",
            "value": "{key}-{title}",
            "label": "Key and title",
            "hint": "web-42-keep-the-session-cookie — like Jira and GitHub"
          },
          {
            "id": "user-key-title",
            "value": "{user}/{key}-{title}",
            "label": "Login, key and title",
            "hint": "ada/web-42-keep-the-session-cookie — like Linear"
          },
          {
            "id": "type-key",
            "value": "{type}/{key}",
            "label": "Type and key",
            "hint": "feature/web-42 — short"
          },
          {
            "id": "key",
            "value": "{key}",
            "label": "Key only",
            "hint": "web-42 — shortest"
          }
        ]
      },
      {
        "key": "branchAssign",
        "type": "boolean",
        "label": "Assign the issue to whoever creates its branch",
        "default": true
      },
      {
        "key": "branchStatus",
        "type": "status",
        "label": "Status when a branch is created",
        "description": "Leave empty to keep the status."
      }
    ],
    "credentials": [
      {
        "key": "githubToken",
        "label": "Your GitHub token (optional)",
        "description": "Optional: branches with your GitHub login in their name, and who reviewed. Without it the plugin uses the project's GitHub connection. Fine-grained: Contents read and write, Pull requests and Checks read.",
        "level": "user",
        "host": "api.github.com",
        "format": "Bearer {value}"
      }
    ],
    "inboundHooks": [
      {
        "id": "github",
        "title": "GitHub repository",
        "provider": "github",
        "handle": "link",
        "rules": [
          {
            "id": "opened",
            "title": "When a pull request is opened",
            "on": "pull_request.opened"
          },
          {
            "id": "merged",
            "title": "When a pull request is merged",
            "on": "pull_request.merged"
          }
        ]
      }
    ]
  },
  "previews": [
    {
      "file": "preview-1.webp",
      "title": "Pull requests on the board"
    },
    {
      "file": "preview-2.webp",
      "title": "Development panel in the issue"
    },
    {
      "file": "preview-3.webp",
      "title": "Webhook and rules"
    }
  ]
}
